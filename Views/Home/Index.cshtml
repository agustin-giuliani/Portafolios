@{
    ViewData["Title"] = "Inicio";
}

@using TuProyecto.Models
@model Proyecto

<!-- HERO -->
<section class="hero-section py-5" data-aos="fade-down">
    <div class="row align-items-center g-5">

        <div class="col-lg-7 order-2 order-lg-1">

            <span class="badge rounded-pill bg-primary-subtle text-primary mb-3 px-3 py-2">
                <i class="bi bi-code-slash me-1"></i>
                Desarrollador de Software | Data Analyst
            </span>

            <h1 class="display-3 fw-bold mb-3">
                Agustín Giuliani
            </h1>

            <h2 class="h4 text-secondary mb-4">
                Desarrollo soluciones y transformo datos en información.
            </h2>

            <p class="text-muted fs-5 mb-4">
                Técnico Superior en Desarrollo de Software.
                Experiencia en soporte ERP, consultas SQL,
                desarrollo backend y análisis de datos.
            </p>

            <div class="d-flex flex-wrap gap-3">

                <a asp-controller="Home" asp-action="Projects"
                   class="btn btn-primary btn-lg">
                    <i class="bi bi-folder2-open me-2"></i>
                    Ver proyectos
                </a>

                <a asp-controller="Home" asp-action="Contact"
                   class="btn btn-outline-dark btn-lg">
                    <i class="bi bi-envelope me-2"></i>
                    Contactarme
                </a>

            </div>

        </div>

        <div class="col-lg-5 text-center order-1 order-lg-2">

            <div class="profile-image-container mx-auto">
                <img src="~/img/agus.jpeg"
                     alt="Agustín Giuliani"
                     class="profile-image" />
            </div>

        </div>

    </div>
</section>

<!-- SOBRE MI -->
<section class="py-5" data-aos="fade-up">

    <div class="section-heading mb-4">
        <span class="text-primary fw-semibold">CONOCEME</span>
        <h2 class="fw-bold mt-2">Sobre mí</h2>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <p class="text-muted">
                Trabajo en soporte técnico con sistemas ERP,
                realizando consultas SQL, validación de datos y
                análisis de información en entornos reales.
                Esta experiencia me permitió desarrollar una
                comprensión sólida de los procesos de negocio
                y la resolución de problemas.
            </p>

            <p class="text-muted mb-0">
                Actualmente continúo ampliando mis conocimientos
                en desarrollo backend con C# y .NET, bases de datos
                y análisis de datos con Python y Power BI,
                aplicándolos en proyectos propios.
            </p>

        </div>
    </div>

</section>

<!-- STACK -->
<section class="py-4" data-aos="fade-up">

    <div class="section-heading mb-4">
        <span class="text-primary fw-semibold">TECNOLOGÍAS</span>
        <h2 class="fw-bold mt-2">Stack tecnológico</h2>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <div class="row g-4">

                <div class="col-md-4">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-code-slash text-primary me-2"></i>
                        Desarrollo
                    </h6>

                    <span class="tech-badge">C#</span>
                    <span class="tech-badge">.NET</span>
                    <span class="tech-badge">ASP.NET MVC</span>
                    <span class="tech-badge">Python</span>
                </div>

                <div class="col-md-4">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-database text-primary me-2"></i>
                        Bases de datos
                    </h6>

                    <span class="tech-badge">SQL Server</span>
                    <span class="tech-badge">MySQL</span>
                    <span class="tech-badge">Firebird</span>
                    <span class="tech-badge">SQL</span>
                </div>

                <div class="col-md-4">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-bar-chart text-primary me-2"></i>
                        Herramientas
                    </h6>

                    <span class="tech-badge">Power BI</span>
                    <span class="tech-badge">Git</span>
                    <span class="tech-badge">Visual Studio</span>
                    <span class="tech-badge">IBExpert</span>
                </div>

            </div>

        </div>
    </div>

</section>

<!-- PROYECTO DESTACADO -->
@if (Model != null)
{
    <section class="py-5" data-aos="fade-up">

        <div class="section-heading mb-4">
            <span class="text-primary fw-semibold">MI TRABAJO</span>
            <h2 class="fw-bold mt-2">Proyecto destacado</h2>
        </div>

        <div class="card border-0 shadow-sm featured-project">

            <div class="card-body p-4">

                <div class="d-flex align-items-center mb-3">
                    <div class="project-icon me-3">
                        <i class="bi bi-laptop"></i>
                    </div>

                    <div>
                        <h4 class="fw-bold mb-1">
                            @Model.Titulo
                        </h4>
                        <small class="text-muted">
                            Proyecto destacado
                        </small>
                    </div>
                </div>

                <p class="text-muted">
                    @Model.Descripcion
                </p>

                <div class="mb-4">
                    @foreach (var tech in (Model.Tecnologias ?? "")
                                    .Split(',', StringSplitOptions.RemoveEmptyEntries))
                    {
                        <span class="tech-badge">@tech.Trim()</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Url))
                {
                    <a href="@Model.Url"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="btn btn-outline-primary">
                        <i class="bi bi-box-arrow-up-right me-2"></i>
                        Ver proyecto
                    </a>
                }

            </div>
        </div>

    </section>
}

<!-- CONTACTO FINAL -->
<section class="text-center py-5 my-4" data-aos="fade-up">

    <h2 class="fw-bold">¿Trabajamos juntos?</h2>

    <p class="text-muted">
        Estoy abierto a nuevas oportunidades profesionales
        y proyectos relacionados con desarrollo y análisis de datos.
    </p>

    <a asp-controller="Home" asp-action="Contact"
       class="btn btn-primary btn-lg mt-2">
        <i class="bi bi-envelope me-2"></i>
        Contactarme
    </a>

</section>



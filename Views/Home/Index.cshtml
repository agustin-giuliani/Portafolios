@{
    ViewData["Title"] = "Inicio";
}

@using TuProyecto.Models
@model Proyecto

<div class="home-page">

    <!-- PRESENTACIÓN -->
    <section class="intro-section" data-aos="fade-up">

        <div class="row align-items-center gy-5">

            <div class="col-lg-7">

                <div class="intro-label">
                    <span class="intro-indicator"></span>
                    PORTFOLIO PROFESIONAL
                </div>

                <p class="intro-greeting">Hola, soy</p>

                <h1 class="intro-name">
                    Agustín <span>Giuliani.</span>
                </h1>

                <h2 class="intro-profession">
                    Técnico Superior en Desarrollo de Software
                </h2>

                <p class="intro-description">
                    Me desempeño en el ámbito de la tecnología, combinando
                    soporte técnico de sistemas ERP, análisis funcional y
                    gestión de información mediante SQL.
                </p>

                <p class="intro-description">
                    Mi formación en desarrollo de software y mi interés por
                    el análisis de datos me impulsan a seguir aprendiendo,
                    explorar nuevas tecnologías y construir soluciones
                    que respondan a problemas reales.
                </p>

                <p class="intro-description">
                    En este espacio comparto mis proyectos, conocimientos
                    y experiencias. Te invito a conocer mi recorrido
                    profesional y explorar mi trabajo.
                </p>

                <div class="intro-actions">

                    <a asp-controller="Home"
                       asp-action="Projects"
                       class="btn btn-accent">
                        <i class="bi bi-folder2-open me-2"></i>
                        Explorar proyectos
                    </a>

                    <a asp-controller="Home"
                       asp-action="About"
                       class="btn btn-outline-light-custom">
                        Conocer mi perfil
                        <i class="bi bi-arrow-up-right ms-2"></i>
                    </a>

                </div>

                <div class="intro-socials">

                    <span>También podés encontrarme en</span>

                    <a href="https://github.com/agustin-giuliani"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="GitHub">
                        <i class="bi bi-github"></i>
                    </a>

                    <a href="https://linkedin.com/in/agustin-giuliani"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="LinkedIn">
                        <i class="bi bi-linkedin"></i>
                    </a>

                </div>

            </div>

            <div class="col-lg-5">

                <div class="intro-visual">

                    <div class="visual-decoration visual-decoration-one"></div>
                    <div class="visual-decoration visual-decoration-two"></div>

                    <div class="profile-image-container">
                        <img src="~/img/agus.jpeg"
                             alt="Fotografía de Agustín Giuliani"
                             class="profile-image" />
                    </div>

                    <div class="profile-caption">
                        <span class="caption-indicator"></span>
                        Córdoba, Argentina
                    </div>

                    <div class="visual-code visual-code-top">
                        <i class="bi bi-code-slash"></i>
                        <span>Desarrollo</span>
                    </div>

                    <div class="visual-code visual-code-bottom">
                        <i class="bi bi-database"></i>
                        <span>Datos & SQL</span>
                    </div>

                </div>

            </div>

        </div>

    </section>

    <!-- PROPUESTA PROFESIONAL -->
    <section class="approach-section" data-aos="fade-up">

        <div class="approach-heading">
            <span class="section-eyebrow">MI ENFOQUE</span>
            <h2>Conocimiento técnico con una mirada práctica.</h2>
            <p>
                Mi recorrido profesional me permitió desarrollar una visión
                que conecta la tecnología con las necesidades de las personas
                y los procesos de negocio.
            </p>
        </div>

        <div class="row g-3">

            <div class="col-md-4">
                <article class="approach-card">
                    <div class="approach-icon">
                        <i class="bi bi-headset"></i>
                    </div>

                    <h3>Resolución de problemas</h3>

                    <p>
                        Analizar incidencias, comprender su origen y buscar
                        soluciones que permitan mejorar el funcionamiento
                        de los sistemas.
                    </p>
                </article>
            </div>

            <div class="col-md-4">
                <article class="approach-card">
                    <div class="approach-icon">
                        <i class="bi bi-code-square"></i>
                    </div>

                    <h3>Desarrollo de software</h3>

                    <p>
                        Aplicar conocimientos de programación y desarrollo
                        backend para transformar ideas y necesidades
                        en soluciones concretas.
                    </p>
                </article>
            </div>

            <div class="col-md-4">
                <article class="approach-card">
                    <div class="approach-icon">
                        <i class="bi bi-bar-chart-line"></i>
                    </div>

                    <h3>Análisis de información</h3>

                    <p>
                        Trabajar con datos para validar información,
                        detectar inconsistencias y obtener conclusiones
                        útiles para la toma de decisiones.
                    </p>
                </article>
            </div>

        </div>

    </section>

    <!-- CIERRE -->
    <section class="home-cta" data-aos="fade-up">

        <span class="section-eyebrow">SIGAMOS EN CONTACTO</span>

        <h2>¿Tenés un proyecto o una oportunidad?</h2>

        <p>
            Estoy abierto a nuevos desafíos profesionales,
            proyectos y oportunidades para seguir creciendo
            en el mundo de la tecnología.
        </p>

        <a asp-controller="Home"
           asp-action="Contact"
           class="btn btn-accent">
            <i class="bi bi-envelope me-2"></i>
            Contactarme
        </a>

    </section>

</div>

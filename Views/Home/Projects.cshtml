@using TuProyecto.Models
@model List<Proyecto>

@{
    ViewData["Title"] = "Proyectos";
}

<div class="projects-page">

    <!-- ENCABEZADO -->
    <section class="projects-header" data-aos="fade-up">

        <span class="section-eyebrow">MI TRABAJO</span>

        <h1>Proyectos <span>desarrollados.</span></h1>

        <p>
            Una selección de proyectos en los que aplico mis conocimientos
            de desarrollo de software, bases de datos y análisis de información.
            Cada uno representa una oportunidad para aprender y resolver
            problemas mediante la tecnología.
        </p>

        <div class="projects-counter">
            <i class="bi bi-folder2-open"></i>
            <span>
                @(Model?.Count ?? 0)
                @((Model?.Count ?? 0) == 1 ? "proyecto publicado" : "proyectos publicados")
            </span>
        </div>

    </section>

    <!-- LISTADO DE PROYECTOS -->
    <section class="projects-list-section">

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">

                @{
                    int delay = 0;
                }

                @foreach (var proyecto in Model)
                {
                    <div class="col-md-6 col-xl-4"
                         data-aos="fade-up"
                         data-aos-delay="@delay">

                        <article class="project-card">

                            <div class="project-card-top">

                                <div class="project-card-icon">
                                    <i class="bi bi-code-square"></i>
                                </div>

                                <span class="project-card-label">
                                    PROYECTO
                                </span>

                            </div>

                            <div class="project-card-content">

                                <h2>@proyecto.Titulo</h2>

                                <p class="project-description">
                                    @proyecto.Descripcion
                                </p>

                                @if (!string.IsNullOrWhiteSpace(proyecto.Tecnologias))
                                {
                                    <div class="project-technologies">

                                        <span class="project-meta-title">
                                            TECNOLOGÍAS
                                        </span>

                                        <div class="project-tags">

                                            @foreach (var tech in proyecto.Tecnologias.Split(
                                                                            ',',
                                                                            StringSplitOptions.RemoveEmptyEntries))
                                            {
                                                <span>@tech.Trim()</span>
                                            }

                                        </div>

                                    </div>
                                }

                            </div>

                            <div class="project-card-actions">

                                @if (!string.IsNullOrWhiteSpace(proyecto.Url))
                                {
                                    <a href="@proyecto.Url"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       class="project-action-primary">
                                        <i class="bi bi-box-arrow-up-right"></i>
                                        Ver proyecto
                                    </a>
                                }

                                @if (!string.IsNullOrWhiteSpace(proyecto.ArchivoRuta))
                                {
                                    <a asp-action="DescargarArchivo"
                                       asp-controller="Home"
                                       asp-route-id="@proyecto.Id"
                                       class="project-action-secondary">
                                        <i class="bi bi-download"></i>
                                        Descargar
                                    </a>
                                }

                                @if (string.IsNullOrWhiteSpace(proyecto.Url)
                                                        && string.IsNullOrWhiteSpace(proyecto.ArchivoRuta))
                                {
                                    <span class="project-unavailable">
                                        <i class="bi bi-info-circle"></i>
                                        Sin enlace disponible
                                    </span>
                                }

                            </div>

                        </article>

                    </div>

                    delay += 100;
                }

            </div>
        }
        else
        {
            <div class="projects-empty" data-aos="fade-up">

                <div class="projects-empty-icon">
                    <i class="bi bi-folder2-open"></i>
                </div>

                <h2>Estamos preparando esta sección.</h2>

                <p>
                    Próximamente vas a encontrar acá mis proyectos
                    y trabajos relacionados con tecnología y desarrollo.
                </p>

            </div>
        }

    </section>

    <!-- CIERRE -->
    <section class="projects-cta" data-aos="fade-up">

        <span class="section-eyebrow">¿TENÉS UNA IDEA?</span>

        <h2>Hablemos de tecnología.</h2>

        <p>
            Estoy abierto a conocer nuevos proyectos, compartir ideas
            y explorar oportunidades de colaboración.
        </p>

        <a asp-controller="Home"
           asp-action="Contact"
           class="btn btn-accent">
            <i class="bi bi-envelope me-2"></i>
            Contactarme
        </a>

    </section>

</div>
